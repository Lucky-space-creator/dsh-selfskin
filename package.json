{
  "name": "dsh-selfskin",
  "version": "1.2.0",
  "description": "DSH SelfSkin - 为 DeepSeek Harness 桌面端提供皮肤特效与按钮特效：内置皮肤 + 自定义导入、DIY 主题工作室（种子色推导整套令牌 + 实时预览）、氛围特效（极光 / 光尘 / 毛玻璃 / 壁纸）、可开关的按钮涟漪与流光。",
  "license": "MIT",
  "author": "dsh-selfskin",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "theme",
    "skin",
    "wallpaper",
    "effects",
    "ripple"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node test/validate-package.mjs && node test/pure.test.mjs && node test/derive.test.mjs && node test/client-harness.mjs",
    "verify": "npm run build && npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
